#!/bin/sh
# Purge deliberately leaves /etc/goodix550c (PSK) and /var/lib/fprint (prints) alone.
set -e
case "$1" in
remove|purge)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl try-restart fprintd.service || true
    fi
    # byte-code written at run time is not owned by dpkg
    rm -rf /usr/lib/python3/dist-packages/goodix550c_tui/__pycache__ || true
    rmdir /usr/lib/python3/dist-packages/goodix550c_tui 2>/dev/null || true
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload || true
    fi
    ;;
esac
exit 0
