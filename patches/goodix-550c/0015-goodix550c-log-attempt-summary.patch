@@ -1407,12 +1419,43 @@
              cleanup_error->message);
 }
 
+static const gchar *
+goodix_summary_phase_name (gint phase)
+{
+  switch (phase)
+    {
+    case GOODIX_SUMMARY_PHASE_CLAIM: return "claim";
+    case GOODIX_SUMMARY_PHASE_PING: return "ping";
+    case GOODIX_SUMMARY_PHASE_FW: return "fw";
+    case GOODIX_SUMMARY_PHASE_OTP: return "otp";
+    case GOODIX_SUMMARY_PHASE_TLS: return "tls";
+    default: return "done";
+    }
+}
+
+/* One integer-only line per open. Gated by GOODIX550C_LOG_SUMMARY=1, read at
+ * open. g_message is used so it reaches the journal without G_MESSAGES_DEBUG. */
+static void
+goodix_log_open_summary (FpiDeviceGoodix53x5 *self,
+                         gboolean             ok)
+{
+  if (!self->log_summary)
+    return;
+
+  g_message ("goodix550c open: result=%s ms=%d phase=%s drain_bytes=0 tls_retry=0",
+             ok ? "ok" : "fail",
+             (int) ((g_get_monotonic_time () - self->summary_open_start_us) / 1000),
+             goodix_summary_phase_name (ok ? GOODIX_SUMMARY_PHASE_DONE :
+                                        self->summary_open_phase));
+}
