 goodix_open_ssm_done (FpiSsm *ssm, FpDevice *dev, GError *error)
 {
   FpiDeviceGoodix53x5 *self = FPI_DEVICE_GOODIX53X5 (dev);
 
   self->task_ssm = NULL;
+  goodix_log_open_summary (self, error == NULL);
 
   /* The experimental polling path needs the two-sample-stable raw baseline
    * for the duration of the open session. The default-off path retains the
@@ -1443,6 +1486,9 @@
 
