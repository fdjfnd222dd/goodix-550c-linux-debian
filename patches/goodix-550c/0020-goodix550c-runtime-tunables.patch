+/* Load the runtime tunables once per open and log their effective values
+ * (integers only) when GOODIX550C_LOG_SUMMARY=1. */
+static void
+goodix_tune_load (FpiDeviceGoodix53x5 *self)
+{
+  g_autoptr(GString) line = g_string_new ("goodix550c tune:");
+
+#define GOODIX_TUNE_LOAD(name, def, lo, hi) \
+  GOODIX_TUNE (self, name) = goodix550c_tune_int (#name, (def), (lo), (hi)); \
+  g_string_append_printf (line, " " #name "=%d", GOODIX_TUNE (self, name));
+  GOODIX_TUNE_TABLE (GOODIX_TUNE_LOAD)
+#undef GOODIX_TUNE_LOAD
+
+  if (self->log_summary)
+    g_message ("%s", line->str);
+}
