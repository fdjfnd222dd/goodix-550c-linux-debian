diff -ru a/drivers/goodix53x5/goodix53x5-private.h b/drivers/goodix53x5/goodix53x5-private.h
--- a/drivers/goodix53x5/goodix53x5-private.h
+++ b/drivers/goodix53x5/goodix53x5-private.h
@@ -172,6 +172,93 @@
  * reported anyway and the ordinary bounded finger-up wait continues. */
 #define GOODIX_RESULT_FINGER_UP_WAIT_MS 1500
 
+/* Manual-FDT timing constants (moved here from goodix53x5-scan.c so the
+ * runtime tunable table below can name them). */
+#define GOODIX_MANUAL_FDT_POLL_DELAY_MS 100
+#define GOODIX_MANUAL_FDT_CONFIRMATIONS 2
+#define GOODIX_MANUAL_FDT_DOWN_SETTLE_MS 300
+
+/* Default of the verify non-contact gate, in thousandths. Equal to
+ * GOODIX_VERIFY_NO_CONTACT_FRACTION (0.90); the gate compares
+ * fraction > x1000 / 1000.0. */
+#define GOODIX_VERIFY_NO_CONTACT_X1000 900
+
+/* Runtime tunables, GOODIX550C_TUNE_<NAME>=<integer> in the environment.
+ *
+ * Read once per device open (goodix_tune_load), parsed strictly, clamped to
+ * [min,max] and cached in the device. Unset or invalid falls back to the
+ * compiled default, which equals the historical constant, so behaviour is
+ * unchanged with no environment. Adding a tunable is one X() line:
+ *   X(NAME, default, min, max)
+ *
+ * Safety-relevant knobs only move in the stricter direction: a larger
+ * keypoint floor, a smaller allowed non-contact fraction, a larger
+ * reference-mean cut, a shorter finger-up hold, never above today's bound.
+ * ENROLL_SAMPLES is also read by class_init (nr_enroll_stages) and the
+ * enroll state machine takes the count from the device class, so the two
+ * cannot disagree.
+ *
+ * NEVER list here: the match acceptance threshold, the clear-window bound, the persistent-command
+ * deny list, the firmware gate, PSK handling, or anything that would make a
+ * wait unbounded. Every max below keeps its wait finite. */
+#define GOODIX_ENROLL_SAMPLES_MIN 16
+#define GOODIX_ENROLL_SAMPLES_MAX 30
+
+#define GOODIX_TUNE_TABLE(X) \
+  X (SETTLE_MS,        GOODIX_MANUAL_FDT_DOWN_SETTLE_MS,  100,  500)  \
+  X (CONFIRMATIONS,    GOODIX_MANUAL_FDT_CONFIRMATIONS,     1,    3)  \
+  X (POLL_DELAY_MS,    GOODIX_MANUAL_FDT_POLL_DELAY_MS,    50,  150)  \
+  X (TOUCH_MIN_NEG,    GOODIX_FDT_TOUCH_MIN_NEG,           15,   35)  \
+  X (LIFT_MIN_POS,     GOODIX_FDT_LIFT_MIN_POS,            15,   35)  \
+  X (REF_FINGER_MEAN_MAX, GOODIX_REF_FINGER_MEAN_MAX,    2000, 2150)  \
+  X (CLEAR_POLLS,      GOODIX_CLEAR_CONSECUTIVE_POLLS,      1,    3)  \
+  X (UP_WAIT_MS,       GOODIX_RESULT_FINGER_UP_WAIT_MS,   500, 1500)  \
+  X (NONCONTACT_X1000, GOODIX_VERIFY_NO_CONTACT_X1000,    300,  900)  \
+  X (MIN_KEYPOINTS,    GOODIX_MIN_CAPTURE_KEYPOINTS,       20,   60)  \
+  X (ENROLL_SAMPLES,   GOODIX_ENROLL_SAMPLES,  GOODIX_ENROLL_SAMPLES_MIN, GOODIX_ENROLL_SAMPLES_MAX)
+
+typedef enum
+{
+#define GOODIX_TUNE_ENUM(name, def, lo, hi) GOODIX_TUNE_##name,
+  GOODIX_TUNE_TABLE (GOODIX_TUNE_ENUM)
+#undef GOODIX_TUNE_ENUM
+  GOODIX_TUNE_COUNT
+} GoodixTune;
+
+/* Every default must sit inside its own clamp. */
+#define GOODIX_TUNE_CHECK(name, def, lo, hi) \
+  G_STATIC_ASSERT ((lo) <= (def) && (def) <= (hi) && (lo) <= (hi));
+GOODIX_TUNE_TABLE (GOODIX_TUNE_CHECK)
+#undef GOODIX_TUNE_CHECK
+
+#define GOODIX_TUNE(self, name) ((self)->tune[GOODIX_TUNE_##name])
+
+/* Read GOODIX550C_TUNE_<name> (name without prefix). Strict base-10 integer;
+ * unset -> def silently, invalid -> def with a warning (the value is not
+ * echoed); a valid value is clamped to [min,max]. */
+static inline gint
+goodix550c_tune_int (const gchar *name,
+                     gint         def,
+                     gint         min,
+                     gint         max)
+{
+  g_autofree gchar *key = g_strconcat ("GOODIX550C_TUNE_", name, NULL);
+  const gchar *text = g_getenv (key);
+  gint64 value;
+
+  if (text == NULL)
+    return CLAMP (def, min, max);
+
+  if (!g_ascii_string_to_signed (text, 10, G_MININT32, G_MAXINT32, &value, NULL))
+    {
+      g_warning ("goodix550c tune: %s has an invalid value, using default %d",
+                 key, def);
+      return CLAMP (def, min, max);
+    }
+
+  return (gint) CLAMP (value, (gint64) min, (gint64) max);
+}
+
 /* PSK white box for writing all-zero PSK */
 #define GOODIX_PSK_WHITE_BOX_LEN 96
 
@@ -332,6 +419,8 @@
   /* Log-only attempt/open summary state (GOODIX550C_LOG_SUMMARY=1). Nothing
    * here is read by any decision; it only feeds the integer summary lines. */
   gboolean   log_summary;
+  /* Effective runtime tunables (GOODIX_TUNE_TABLE), loaded once per open. */
+  gint       tune[GOODIX_TUNE_COUNT];
   gint64     summary_open_start_us;
   gint       summary_open_phase;
 
@@ -360,6 +449,15 @@
   gint       summary_up_wait_ms;
   gint       summary_up_first;
   guint      summary_lift_rebases;
+  gint64     summary_capture_start_us;
+  gint64     summary_capture_end_us;
+  gint64     summary_match_start_us;
+  gint64     summary_match_end_us;
+  gint64     summary_result_us;
+  gint       summary_templates_scored;
+  gint       summary_best_idx;
+  gint       summary_top_score;
+  gint       summary_second_best;
 };
 
 /* Open phases reached, in order, for the open summary line. */
