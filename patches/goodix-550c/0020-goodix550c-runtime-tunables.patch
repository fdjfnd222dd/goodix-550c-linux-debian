From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fingerprint Lab <noreply@example.invalid>
Date: Sat, 17 Oct 2026 18:00:00 +0200
Subject: [PATCH] goodix550c: bounded runtime tunables and attempt timing

Experiments on timing and gate constants used to cost a rebuilt deb each. Read
a small table of bounded integer overrides from the environment instead
(GOODIX550C_TUNE_<NAME>=<int>), once per device open, parsed strictly with
g_ascii_string_to_signed (an invalid value falls back to the default with a
warning that does not echo it), clamped to a per-entry [min,max] and cached in
the device. With nothing set every default equals the former constant, so
behaviour is unchanged. One `goodix550c tune: NAME=value ...` line lists the
effective integers at open when GOODIX550C_LOG_SUMMARY=1.

Tunable: SETTLE_MS, CONFIRMATIONS, POLL_DELAY_MS, TOUCH_MIN_NEG, LIFT_MIN_POS,
REF_FINGER_MEAN_MAX, CLEAR_POLLS, UP_WAIT_MS, NONCONTACT_X1000, MIN_KEYPOINTS
(verify/identify only) and ENROLL_SAMPLES (16..30; nr_enroll_stages is read at
class init and the enroll state machine takes the count from the class).
Safety-relevant knobs move only in the stricter direction: more keypoints, a
smaller allowed non-contact fraction, a larger reference-mean cut, and a
finger-up hold that can only shorten. Adding one is a single X() line in
GOODIX_TUNE_TABLE.

Never tunable: GOODIX_SIGFM_BEST_MIN, the persistent-command deny list, the
firmware gate, PSK handling, self-heal, the clear-window bound. Every maximum
keeps its wait bounded and no matcher constant is exposed.

The attempt summary gains down_to_result_ms (finger-down confirmed to result
reported), capture_ms (capture state machine), match_ms (SIGFM extraction and
comparison up to the queued verdict), templates_scored, best_idx (sample index
of the best score within its print) and second_best. Log-only; nothing reads
them.
---
diff -ru a/drivers/goodix53x5/goodix53x5-auth.c b/drivers/goodix53x5/goodix53x5-auth.c
--- a/drivers/goodix53x5/goodix53x5-auth.c
+++ b/drivers/goodix53x5/goodix53x5-auth.c
@@ -74,6 +74,27 @@
     }
 }
 
+/* Log-only: counts scored samples and tracks the best and second-best score
+ * and the sample index of the best one. Decides nothing. With the early exit
+ * after a match, later samples are not scored and so not counted. */
+static void
+goodix_summary_note_score (FpiDeviceGoodix53x5 *self,
+                           gint                 score,
+                           gint                 sample_idx)
+{
+  self->summary_templates_scored++;
+  if (self->summary_best_idx < 0 || score > self->summary_top_score)
+    {
+      self->summary_second_best = self->summary_top_score;
+      self->summary_top_score = score;
+      self->summary_best_idx = sample_idx;
+    }
+  else if (score > self->summary_second_best)
+    {
+      self->summary_second_best = score;
+    }
+}
+
 /* One integer-only line per verify/identify attempt, gated by
  * GOODIX550C_LOG_SUMMARY=1. g_message reaches the journal without
  * G_MESSAGES_DEBUG. Reads state only; decides nothing. */
@@ -83,10 +104,33 @@
 {
   gint result = self->summary_result;
   gint ready_to_down_ms = 0;
+  gint down_to_result_ms = 0;
+  gint capture_ms = 0;
+  gint match_ms = 0;
 
   if (!self->log_summary)
     return;
 
+  /* Timing only: finger-down confirmed to result reported (or to now when
+   * no result was reported before this line), capture state machine, and
+   * SIGFM extract+compare up to the point the verdict was queued. */
+  if (self->summary_down_us != 0)
+    {
+      gint64 end_us = self->summary_result_us != 0 ?
+                      self->summary_result_us : g_get_monotonic_time ();
+
+      if (end_us >= self->summary_down_us)
+        down_to_result_ms = (gint) ((end_us - self->summary_down_us) / 1000);
+    }
+  if (self->summary_capture_start_us != 0 &&
+      self->summary_capture_end_us >= self->summary_capture_start_us)
+    capture_ms = (gint) ((self->summary_capture_end_us -
+                          self->summary_capture_start_us) / 1000);
+  if (self->summary_match_start_us != 0 &&
+      self->summary_match_end_us >= self->summary_match_start_us)
+    match_ms = (gint) ((self->summary_match_end_us -
+                        self->summary_match_start_us) / 1000);
+
   if (self->summary_ready_us != 0 && self->summary_down_us >= self->summary_ready_us)
     ready_to_down_ms = (gint) ((self->summary_down_us - self->summary_ready_us) / 1000);
 
@@ -95,7 +139,9 @@
              "keypoints=%d best_score=%d early_exit=%d threshold=%d "
              "result=%s dmax_pos=%d dmax_neg=%d "
              "clear_ms=%d clear_dev_polls=%u clear_rejects=%u "
-             "up_wait_ms=%d up_first=%d lift_rebase=%u",
+             "up_wait_ms=%d up_first=%d lift_rebase=%u "
+             "down_to_result_ms=%d capture_ms=%d match_ms=%d "
+             "templates_scored=%d best_idx=%d second_best=%d",
              action == FPI_DEVICE_ACTION_IDENTIFY ? "identify" : "verify",
              ready_to_down_ms, self->summary_down_polls,
              self->summary_settle_ms, self->summary_ref_mean,
@@ -108,7 +154,10 @@
              self->summary_clear_ms, self->summary_clear_dev_polls,
              self->clear_reject_streak,
              self->summary_up_wait_ms, self->summary_up_first,
-             self->summary_lift_rebases);
+             self->summary_lift_rebases,
+             down_to_result_ms, capture_ms, match_ms,
+             self->summary_templates_scored, self->summary_best_idx,
+             self->summary_second_best);
 }
 
 /* Verify/Identify SSM */
@@ -158,6 +207,8 @@
   self->pending_result_action = FPI_DEVICE_ACTION_VERIFY;
   self->pending_verify_result = result;
   self->pending_result_error = error;
+  if (self->summary_match_end_us == 0)
+    self->summary_match_end_us = g_get_monotonic_time ();
 }
 
 static void
@@ -172,6 +223,8 @@
   if (match != NULL)
     self->pending_identify_match = g_object_ref (match);
   self->pending_result_error = error;
+  if (self->summary_match_end_us == 0)
+    self->summary_match_end_us = g_get_monotonic_time ();
 }
 
