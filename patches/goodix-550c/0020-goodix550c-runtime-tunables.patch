--- a/drivers/goodix53x5/goodix53x5-calibration.c
+++ b/drivers/goodix53x5/goodix53x5-calibration.c
@@ -408,16 +408,27 @@
  * Everything else is AMBIGUOUS and is not a touch.
  */
 GoodixFdtDirection
-goodix_device_classify_fdt_direction (gint pos,
-                                      gint neg)
+goodix_device_classify_fdt_direction_with (gint pos,
+                                           gint neg,
+                                           gint touch_min_neg,
