@@ -570,9 +568,9 @@
             stable = changed_pairs == 0;
             goodix_manual_fdt_log_poll (state, phase, stable);
             if (stable &&
-                state->consecutive >= GOODIX_MANUAL_FDT_CONFIRMATIONS &&
+                state->consecutive >= GOODIX_TUNE (self, CONFIRMATIONS) &&
