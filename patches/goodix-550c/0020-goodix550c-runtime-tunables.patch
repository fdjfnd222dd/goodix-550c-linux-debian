                         GOODIX_REFERENCE_FINGER_MAX_RETRIES);
                 fpi_ssm_jump_to_state_delayed (ssm, GOODIX_REF_CAPTURE_REG_ON,
@@ -822,7 +820,7 @@
           g_clear_pointer (&state->provisional_baseline, g_free);
           fpi_ssm_jump_to_state_delayed (ssm,
                                          GOODIX_REF_CAPTURE_CLEAR_REQUEST,
-                                         GOODIX_MANUAL_FDT_POLL_DELAY_MS);
