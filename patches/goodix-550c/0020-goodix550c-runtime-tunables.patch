@@ -183,6 +236,8 @@
     return;
 
   self->action_result_reported = TRUE;
+  if (self->summary_result_us == 0)
+    self->summary_result_us = g_get_monotonic_time ();
 
   if (self->pending_result_action == FPI_DEVICE_ACTION_IDENTIFY)
     {
@@ -238,13 +293,15 @@
         GoodixMatchInfo *probe_info;
         int keypoints;
 
+        self->summary_match_start_us = g_get_monotonic_time ();
         self->summary_noncontact_x1000 =
           (gint) (self->captured_clipped_fraction * 1000.0 + 0.5);
 
         /* No contact at all: the finger left before the frame was read. Ask
          * for a longer hold instead of scoring an empty frame, and skip the
          * finger-up wait, since the finger is already up. */
-        if (self->captured_clipped_fraction > GOODIX_VERIFY_NO_CONTACT_FRACTION)
+        if (self->captured_clipped_fraction >
+            GOODIX_TUNE (self, NONCONTACT_X1000) / 1000.0)
           {
             self->summary_result = GOODIX_SUMMARY_RESULT_RETRY_TOO_SHORT;
             if (action == FPI_DEVICE_ACTION_IDENTIFY)
@@ -269,7 +326,7 @@
         keypoints = goodix_match_keypoints_count (probe_info);
         self->summary_keypoints = keypoints;
 
-        if (keypoints < GOODIX_MIN_CAPTURE_KEYPOINTS)
+        if (keypoints < GOODIX_TUNE (self, MIN_KEYPOINTS))
           {
             self->summary_result = GOODIX_SUMMARY_RESULT_RETRY_REMOVE_FINGER;
             if (action == FPI_DEVICE_ACTION_IDENTIFY)
@@ -348,6 +405,7 @@
                           }
 
                         valid_templates++;
+                        goodix_summary_note_score (self, score, sample_idx);
                         fp_dbg ("identify: gallery[%u] sample %d sigfm_score %d",
                                 i, sample_idx, score);
 
@@ -458,6 +516,7 @@
                           }
 
                         valid_templates++;
+                        goodix_summary_note_score (self, score, sample_idx);
                         fp_dbg ("verify: sample %d sigfm_score %d",
                                 sample_idx, score);
 
@@ -649,6 +708,15 @@
   self->summary_best_score = 0;
   self->summary_early_exit = FALSE;
   self->summary_result = GOODIX_SUMMARY_RESULT_NONE;
+  self->summary_capture_start_us = 0;
+  self->summary_capture_end_us = 0;
+  self->summary_match_start_us = 0;
+  self->summary_match_end_us = 0;
+  self->summary_result_us = 0;
+  self->summary_templates_scored = 0;
+  self->summary_best_idx = -1;
+  self->summary_top_score = 0;
+  self->summary_second_best = 0;
 
   ssm = fpi_ssm_new (dev, goodix_verify_ssm_handler,
                       GOODIX_VERIFY_NUM_STATES);
